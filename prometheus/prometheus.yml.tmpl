# Rendered at startup by compose.yaml, which fills the __NAME__ placeholders.

global:
  scrape_interval: 30s
  evaluation_interval: 30s

storage:
  tsdb:
    # Agents replay their buffered samples after an outage; accept samples
    # up to this old instead of rejecting them. Keep it at least as long as
    # the agents' offline buffer (AGENT_OFFLINE_BUFFER).
    out_of_order_time_window: __OOO_WINDOW__

scrape_configs:
  - job_name: plg-prometheus
    static_configs:
      - targets: [localhost:9090]
  - job_name: plg-loki
    static_configs:
      - targets: [loki:3100]
  - job_name: plg-grafana
    static_configs:
      - targets: [grafana:3000]
  - job_name: plg-gateway
    static_configs:
      - targets: [gateway:9180]

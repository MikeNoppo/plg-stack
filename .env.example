# Generate a filled-in copy with: ./scripts/setup.sh

# --- Deployment mode ---------------------------------------------------------
# Standalone server (Caddy terminates TLS on ports 80/443):
COMPOSE_FILE=compose.yaml:compose.standalone.yaml
GATEWAY_SCHEME=https
# Behind Dokploy (Traefik terminates TLS): remove COMPOSE_FILE and use
# GATEWAY_SCHEME=http

# --- Domains -----------------------------------------------------------------
GRAFANA_DOMAIN=grafana.example.com
INGEST_DOMAIN=ingest.example.com

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Comma-separated plugin IDs installed at startup, e.g. grafana-clock-panel
GRAFANA_PLUGINS=
# sqlite3 (default, stored in the grafana-data volume) or postgres / mysql
GRAFANA_DB_TYPE=sqlite3
GRAFANA_DB_HOST=
GRAFANA_DB_NAME=grafana
GRAFANA_DB_USER=
GRAFANA_DB_PASSWORD=
GRAFANA_DB_SSL_MODE=disable

# --- Agent tokens ------------------------------------------------------------
# One name:token pair per server, separated by commas. Manage them with
# scripts/agent-token.sh (add / rotate / revoke / list).
AGENT_TOKENS=

# --- Self-monitoring ---------------------------------------------------------
# Runs an agent for the server this stack is on (profile "self-monitoring").
COMPOSE_PROFILES=self-monitoring
SELF_MONITORING_NAME=plg-stack
SELF_MONITORING_ENV=production
SELF_MONITORING_TOKEN=change-me
# Override when the ingest domain isn't reachable over HTTPS from this server.
SELF_MONITORING_URL=

# --- Watchdog ----------------------------------------------------------------
# Heartbeat to an external service (healthchecks.io, Uptime Kuma push, ...),
# sent only while every component is healthy. That service alerts when the
# heartbeats stop, including when this whole server is down.
WATCHDOG_URL=
# Optional URL called instead when a component is unhealthy.
WATCHDOG_FAIL_URL=
WATCHDOG_INTERVAL=60

# --- Resources ---------------------------------------------------------------
# Memory limits (k/m/g) and CPU limits (cores); 0 means unlimited.
PROMETHEUS_MEMORY_LIMIT=1g
PROMETHEUS_CPUS=1
LOKI_MEMORY_LIMIT=1g
LOKI_CPUS=1
GRAFANA_MEMORY_LIMIT=512m
GRAFANA_CPUS=1
GATEWAY_MEMORY_LIMIT=256m
GATEWAY_CPUS=0.5
SELF_MONITORING_MEMORY_LIMIT=512m

# --- Container logs of the stack -----------------------------------------------
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Metrics -----------------------------------------------------------------
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=8GB
# Agents that were offline replay older samples; accept them up to this age.
# Keep it >= the agents' --offline-buffer.
PROMETHEUS_OOO_WINDOW=24h

# --- Logs --------------------------------------------------------------------
LOKI_RETENTION=14d
# Shorter retention per kind of log (default: LOKI_RETENTION).
LOKI_RETENTION_JOURNAL=7d
LOKI_SHORT_RETENTION_ENVS=development|dev|local.*|test.*
LOKI_SHORT_RETENTION=7d
# Offline agents send their backlog late; reject logs older than this.
LOKI_MAX_LOG_AGE=168h
# Ingest limits (shared by all agents) and per log stream.
LOKI_INGESTION_RATE_MB=8
LOKI_INGESTION_BURST_MB=16
LOKI_PER_STREAM_RATE_MB=3
LOKI_PER_STREAM_BURST_MB=15
LOKI_MAX_LINE_SIZE=256KB
# Query limits that keep heavy searches from exhausting memory.
LOKI_MAX_QUERY_SERIES=500
LOKI_MAX_ENTRIES_PER_QUERY=5000
LOKI_QUERY_TIMEOUT=1m

# --- Loki storage ------------------------------------------------------------
# loki.yaml = local disk, loki-s3.yaml = S3 / S3-compatible bucket.
LOKI_CONFIG=loki.yaml
LOKI_S3_BUCKET=
LOKI_S3_REGION=
# Leave the endpoint and keys empty on AWS with an instance role.
LOKI_S3_ENDPOINT=
LOKI_S3_ACCESS_KEY_ID=
LOKI_S3_SECRET_ACCESS_KEY=
LOKI_S3_FORCE_PATH_STYLE=false

# --- Alert notifications (see grafana/alerting-examples/) --------------------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_SLACK_WEBHOOK_URL=
ALERT_EMAIL_ADDRESSES=
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
GF_SMTP_FROM_ADDRESS=

# --- Image versions ----------------------------------------------------------
GRAFANA_VERSION=13.2.3
PROMETHEUS_VERSION=v3.15.0
LOKI_VERSION=3.7.8
CADDY_VERSION=2.11.7-alpine
ALLOY_VERSION=v1.20.1
ALPINE_VERSION=3.24

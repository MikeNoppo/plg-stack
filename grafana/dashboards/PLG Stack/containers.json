      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(container_start_time_seconds{job=\"cadvisor\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}) or vector(0)",

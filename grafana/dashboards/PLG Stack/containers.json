          "expr": "max by (host, service, container, image) (container_spec_memory_limit_bytes{job=\"cadvisor\", env=~\"$env\", host=~\"$host\", service=~\"$service\"} > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }

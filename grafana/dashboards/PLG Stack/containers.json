          "expr": "(sum(changes(container_start_time_seconds{job=\"cadvisor\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}[$__range])) + count(count_over_time(container_start_time_seconds{job=\"cadvisor\", env=~\"$env\", host=~\"$host\", service=~\"$service\"}[$__range])) - count(container_start_time_seconds{job=\"cadvisor\", env=~\"$env\", host=~\"$host\", service=~\"$service\"})) or vector(0)",

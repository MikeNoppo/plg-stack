{
  "uid": "logs",
  "title": "Logs",
  "description": "Cari log dari semua server: container, journald, dan file log database.",
  "tags": [
    "plg-stack"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "env",
        "label": "Env",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(env)",
        "definition": "label_values(env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "host",
        "label": "Host",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({env=~\"$env\"}, host)",
        "definition": "label_values({env=~\"$env\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "source",
        "label": "Sumber",
        "query": "docker,journal,file",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "docker",
            "value": "docker",
            "selected": false
          },
          {
            "text": "journal",
            "value": "journal",
            "selected": false
          },
          {
            "text": "file",
            "value": "file",
            "selected": false
          }
        ]
      },
      {
        "type": "query",
        "name": "service",
        "label": "Service",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values({env=~\"$env\", host=~\"$host\"}, service)",
        "definition": "label_values({env=~\"$env\", host=~\"$host\"}, service)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Level",
        "query": "emerg,alert,crit,error,warning,notice,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "emerg",
            "value": "emerg",
            "selected": false
          },
          {
            "text": "alert",
            "value": "alert",
            "selected": false
          },
          {
            "text": "crit",
            "value": "crit",
            "selected": false
          },
          {
            "text": "error",
            "value": "error",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          },
          {
            "text": "notice",
            "value": "notice",
            "selected": false
          },
          {
            "text": "info",
            "value": "info",
            "selected": false
          },
          {
            "text": "debug",
            "value": "debug",
            "selected": false
          }
        ]
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Cari",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "plg-stack"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "Volume log per host",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({level=~\"$level\", env=~\"$env\", host=~\"$host\", source=~\"$source\", service=~\"$service\"} |~ \"(?i)$search\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Baris error per host",
      "description": "Baris yang mengandung error, fatal, panic, exception, atau critical.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (host) (count_over_time({level=~\"$level\", env=~\"$env\", host=~\"$host\", source=~\"$source\", service=~\"$service\"} |~ \"(?i)(error|fatal|panic|exception|critical)\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "logs",
      "title": "Log",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{level=~\"$level\", env=~\"$env\", host=~\"$host\", source=~\"$source\", service=~\"$service\"} |~ \"(?i)$search\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 20
      }
    }
  ]
}

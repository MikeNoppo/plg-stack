    {
      "type": "table",
      "title": "Status agent per server",
      "description": "Log difilter = baris yang sengaja dibuang lewat LOG_DROP_REGEX.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, version) (alloy_build_info{job=\"alloy\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host) (prometheus_remote_storage_highest_timestamp_in_seconds{job=\"alloy\"}) - max by (host) (prometheus_remote_storage_queue_highest_sent_timestamp_seconds{job=\"alloy\"} > 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (increase(prometheus_remote_storage_samples_failed_total{job=\"alloy\"}[1h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (increase(loki_write_dropped_entries_total{job=\"alloy\"}[1h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host) (increase(loki_process_dropped_lines_total{job=\"alloy\"}[1h]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "host": 0,
              "version": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "host": "Host",
              "version": "Versi",
              "Value #B": "Tertunda kirim",
              "Value #C": "Metrik terbuang (1j)",
              "Value #D": "Log terbuang (1j)",
              "Value #E": "Log difilter (1j)"
            }
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "Host",
                "Versi",
                "Tertunda kirim",

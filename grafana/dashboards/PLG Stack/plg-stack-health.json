    {
      "type": "stat",
      "title": "Disk metrik vs batas",
      "description": "Pemakaian disk Prometheus dibanding PROMETHEUS_RETENTION_SIZE. Data tertua dihapus saat penuh.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (prometheus_tsdb_storage_blocks_bytes{job=\"plg-prometheus\"} + prometheus_tsdb_wal_storage_size_bytes{job=\"plg-prometheus\"}) / prometheus_tsdb_retention_limit_bytes{job=\"plg-prometheus\"}",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []

{
  "uid": "alert-history",
  "title": "Riwayat Alert",
  "description": "Perubahan status alert dari waktu ke waktu, disimpan di Loki.",
  "tags": [
    "plg-stack"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "severity",
        "label": "Severity",
        "query": "critical,warning",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "critical",
            "value": "critical",
            "selected": false
          },
          {
            "text": "warning",
            "value": "warning",
            "selected": false
          }
        ]
      },
      {
        "type": "custom",
        "name": "state",
        "label": "Status",
        "query": "Alerting,Pending,Normal,NoData,Error,Recovering",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "Alerting",
            "value": "Alerting",
            "selected": false
          },
          {
            "text": "Pending",
            "value": "Pending",
            "selected": false
          },
          {
            "text": "Normal",
            "value": "Normal",
            "selected": false
          },
          {
            "text": "NoData",
            "value": "NoData",
            "selected": false
          },
          {
            "text": "Error",
            "value": "Error",
            "selected": false
          },
          {
            "text": "Recovering",
            "value": "Recovering",
            "selected": false
          }
        ]
      },
      {
        "type": "textbox",
        "name": "search",
        "label": "Cari",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "plg-stack"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Daftar alert",
      "url": "/alerting/list",
      "icon": "bolt",
      "tooltip": "",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tags": []
    },
    {
      "type": "link",
      "title": "Riwayat di Grafana Alerting",
      "url": "/alerting/history",
      "icon": "doc",
      "tooltip": "",
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "targetBlank": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Alert aktif",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(grafana_alerting_alerts{job=\"plg-grafana\", state=\"alerting\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Menunggu",
      "description": "Kondisi alert sudah terpenuhi, tapi belum selama durasi `for` rule-nya.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(grafana_alerting_alerts{job=\"plg-grafana\", state=\"pending\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Alert berbunyi (rentang waktu)",
      "description": "Jumlah perubahan status menjadi Alerting.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({from=\"state-history\"} | json | current=~\"Alerting.*\" | labels_severity=~\"$severity\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Riwayat gagal disimpan",
      "description": "Perubahan status yang gagal ditulis ke Loki, sehingga riwayat di dashboard ini tidak lengkap.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(grafana_alerting_state_history_writes_failed_total{job=\"plg-grafana\"}[$__range]))) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Evaluasi gagal",
      "description": "Rule yang gagal dievaluasi, misalnya karena query error atau datasource tidak bisa dihubungi.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(grafana_alerting_rule_evaluation_failures_total{job=\"plg-grafana\"}[$__range]))) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Alert berbunyi per rule",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (ruleTitle) (count_over_time({from=\"state-history\"} | json | current=~\"Alerting.*\" | labels_severity=~\"$severity\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{ruleTitle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "drawStyle": "bars",
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "bargauge",
      "title": "Paling sering berbunyi",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (ruleTitle) (count_over_time({from=\"state-history\"} | json | current=~\"Alerting.*\" | labels_severity=~\"$severity\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{ruleTitle}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/^Value/"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Perubahan status",
      "description": "Satu baris per perubahan status. Klik baris untuk melihat semua label dan nilainya.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{from=\"state-history\"} |~ \"(?i)$search\" | json | current=~\"(${state}).*\" | labels_severity=~\"$severity\" | (current !~ \"Normal.*\" or previous !~ \"Normal.*\") | line_format `{{.previous}} → {{.current}}  {{.ruleTitle}}{{with .labels_host}}  host={{.}}{{end}}{{with .labels_env}} ({{.}}){{end}}{{with .labels_mountpoint}}  {{.}}{{end}}{{with .labels_service}}  service={{.}}{{end}}{{with .labels_job}}  job={{.}}{{end}}{{with .values_A}}  nilai={{.}}{{end}}`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "prettifyLogMessage": false,
        "showLabels": false,
        "showCommonLabels": false
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 16
      }
    }
  ]
}

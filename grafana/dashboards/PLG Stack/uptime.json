    {
      "type": "stat",
      "title": "Ketersediaan komponen PLG Stack",
      "description": "Diukur Prometheus tiap 30 detik; periode saat Prometheus sendiri mati tidak tercatat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * avg_over_time(up{job=~\"plg-.*\"}[$__range])",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {

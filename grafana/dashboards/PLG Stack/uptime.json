          "expr": "100 * clamp_max(sum_over_time((max by (host, env) (present_over_time(up{job=\"node\", env=~\"$env\", host=~\"$host\"}[1m])))[$__range:1m]) / (scalar(floor(vector(time() / 60))) - ceil(clamp_min(min by (host, env) (min_over_time(timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m])), time() - $__range_s + 0.001) / 60) + 1), 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "60 * clamp_min((scalar(floor(vector(time() / 60))) - ceil(clamp_min(min by (host, env) (min_over_time(timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m])), time() - $__range_s + 0.001) / 60) + 1) - sum_over_time((max by (host, env) (present_over_time(up{job=\"node\", env=~\"$env\", host=~\"$host\"}[1m])))[$__range:1m]), 0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (host, env) (resets((node_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"} - node_boot_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (host, env) (node_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"} - node_boot_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - max by (host, env) (timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"}) or max_over_time(timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],

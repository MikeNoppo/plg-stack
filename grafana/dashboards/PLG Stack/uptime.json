    {
      "type": "stat",
      "title": "Reboot",
      "description": "Jumlah reboot dalam rentang waktu, terlihat dari uptime server yang kembali ke nol.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(sum by (host, env) (resets((node_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"} - node_boot_time_seconds{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m]))) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false

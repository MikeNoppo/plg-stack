    {
      "type": "stat",
      "title": "Total waktu tidak melapor",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(60 * clamp_min((scalar(floor(vector(time() / 60))) - ceil(clamp_min(min by (host, env) (min_over_time(timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m])), time() - $__range_s + 0.001) / 60) + 1) - sum_over_time((max by (host, env) (present_over_time(up{job=\"node\", env=~\"$env\", host=~\"$host\"}[1m])))[$__range:1m]), 0))",

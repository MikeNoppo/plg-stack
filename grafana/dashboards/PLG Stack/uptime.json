  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "env",
        "label": "Env",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"node\"}, env)",
        "definition": "label_values(up{job=\"node\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "type": "query",
        "name": "host",
        "label": "Host",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"node\", env=~\"$env\"}, host)",
        "definition": "label_values(up{job=\"node\", env=~\"$env\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "plg-stack"
      ],
      "asDropdown": true,
      "title": "Dashboards",
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Ketersediaan rata-rata",
      "description": "Persentase menit saat server mengirim data, dihitung sejak data pertamanya dalam rentang waktu ini. Oranye di bawah 99.9%, merah di bawah 99%.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(100 * clamp_max(sum_over_time((max by (host, env) (present_over_time(up{job=\"node\", env=~\"$env\", host=~\"$host\"}[1m])))[$__range:1m]) / (scalar(floor(vector(time() / 60))) - ceil(clamp_min(min by (host, env) (min_over_time(timestamp(up{job=\"node\", env=~\"$env\", host=~\"$host\"})[$__range:1m])), time() - $__range_s + 0.001) / 60) + 1), 1))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 99
              },
              {
                "color": "green",
                "value": 99.9
              }
            ]
          },
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },

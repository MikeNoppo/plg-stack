{
  "uid": "uptime",
  "title": "Uptime",
  "description": "Ketersediaan server, database, dan komponen PLG Stack dalam rentang waktu dashboard.",
  "tags": [
    "plg-stack"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,

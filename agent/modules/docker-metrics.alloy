// `service` follows the same rules as docker-logs. Docker labels:
//   plg.metrics=false  do not collect this container's metrics
//   plg.service=NAME   use NAME as the service label

prometheus.exporter.cadvisor "containers" {
	docker_host            = "unix:///var/run/docker.sock"
	docker_only            = true
	storage_duration       = "2m"
	store_container_labels = false

	allowlisted_container_labels = [
		"com.docker.compose.project",
		"com.docker.compose.service",
		"com.docker.swarm.service.name",
		"plg.metrics",
		"plg.service",
	]
}

discovery.relabel "cadvisor" {
	targets = prometheus.exporter.cadvisor.containers.targets

	rule {
		target_label = "job"
		replacement  = "cadvisor"
	}

	rule {
		target_label = "instance"
		replacement  = sys.env("MONITORING_HOST")
	}
}

prometheus.scrape "cadvisor" {
	targets         = discovery.relabel.cadvisor.output
	forward_to      = [prometheus.relabel.cadvisor.receiver]
	scrape_interval = "30s"
}

prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.default.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "container_(cpu_usage_seconds_total|memory_working_set_bytes|spec_memory_limit_bytes|network_(receive|transmit)_bytes_total|fs_(reads|writes)_bytes_total|start_time_seconds|oom_events_total)"
		action        = "keep"
	}

	rule {
		source_labels = ["name"]
		regex         = ""
		action        = "drop"
	}

	rule {
		source_labels = ["container_label_plg_metrics"]
		regex         = "false"
		action        = "drop"
	}

	rule {
		source_labels = ["name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["container_label_com_docker_compose_service", "container_label_com_docker_swarm_service_name", "name"]
		separator     = ";"
		regex         = "([^;]*);([^;]*);(.*)"
		target_label  = "service"
		replacement   = "$1$2"
	}

	rule {
		source_labels = ["service", "name"]
		separator     = ";"
		regex         = ";(.*)"
		target_label  = "service"
		replacement   = "$1"
	}

	rule {
		source_labels = ["container_label_plg_service"]
		regex         = "(.+)"
		target_label  = "service"
	}

	rule {
		regex  = "container_label_.*|name|id"
		action = "labeldrop"
	}
}

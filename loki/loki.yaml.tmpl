auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: /loki
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules

limits_config:
  retention_period: ${LOKI_RETENTION:-14d}
  # Highest priority wins when several selectors match a stream.
  retention_stream:
    - selector: '{source="journal"}'
      priority: 1
      period: ${LOKI_RETENTION_JOURNAL:-14d}
    - selector: '{env=~"${LOKI_SHORT_RETENTION_ENVS:-development|dev|local.*|test.*}"}'
      priority: 2
      period: ${LOKI_SHORT_RETENTION:-14d}
  reject_old_samples: true
  # Agents that were offline send their backlog late; accept it up to this age.
  reject_old_samples_max_age: ${LOKI_MAX_LOG_AGE:-168h}
  # Without tenants these apply to all agents together; per_stream_* stop a
  # single noisy stream from using up the shared budget.
  ingestion_rate_mb: ${LOKI_INGESTION_RATE_MB:-8}
  ingestion_burst_size_mb: ${LOKI_INGESTION_BURST_MB:-16}
  per_stream_rate_limit: ${LOKI_PER_STREAM_RATE_MB:-3}MB
  per_stream_rate_limit_burst: ${LOKI_PER_STREAM_BURST_MB:-15}MB
  max_line_size: ${LOKI_MAX_LINE_SIZE:-256KB}
  max_line_size_truncate: true
  max_query_series: ${LOKI_MAX_QUERY_SERIES:-500}
  max_entries_limit_per_query: ${LOKI_MAX_ENTRIES_PER_QUERY:-5000}
  query_timeout: ${LOKI_QUERY_TIMEOUT:-1m}
  allow_structured_metadata: true
  volume_enabled: true

compactor:
  working_directory: /loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
  delete_request_store: __DELETE_REQUEST_STORE__

pattern_ingester:
  enabled: true

analytics:
  reporting_enabled: false

# init.sh appends a period for every store Loki has used, then the S3
# settings if one of them is s3.
schema_config:
  configs:
